{
  "name": "relay-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "oxlint",
    "format": "oxfmt",
    "build:demo": "node scripts/build-demo.mjs",
    "test": "vitest run",
    "verify:backend": "node scripts/verify-backend.mjs",
    "check:setup": "node scripts/check-setup.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@base-ui/react": "1.7.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "15.5.25",
    "next-auth": "^4.24.13",
    "nodemailer": "10.0.1",
    "papaparse": "^5.5.3",
    "react": "18.3.1",
    "react-day-picker": "9.8.1",
    "react-dom": "18.3.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "stripe": "^17.7.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^7.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "prisma": "^6.19.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.0",
    "shadcn": "4.18.0"
  },
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "nodemailer": "$nodemailer",
    "postcss": "8.5.28",
    "deepmerge-ts": "8.0.2",
    "undici": "7.29.0",
    "sharp": "^0.35.0",
    "esbuild": "^0.28.1"
  }
}
