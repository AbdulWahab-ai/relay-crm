# Production mode. Demo export sets this to true only in its isolated build.
NEXT_PUBLIC_DEMO_MODE=false
# App URL, also used for same-origin request checks, emails and Stripe redirects.
NEXTAUTH_URL=http://localhost:3000
# Generate a unique secret: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret
# Supabase/Railway: pooled application connection; keep TLS enabled remotely.
DATABASE_URL=postgresql://postgres:password@localhost:5432/relay?schema=public
# Direct connection for Prisma migrations (Supabase direct/session endpoint).
DIRECT_URL=postgresql://postgres:password@localhost:5432/relay?schema=public
# Optional OAuth; both required to show Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Claude Messages API (server-only). Confirm availability and current model rates.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AI_INPUT_USD_PER_MILLION=3
AI_OUTPUT_USD_PER_MILLION=15
# Stripe test-mode values; create monthly, per-seat USD prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
# Protect the scheduled /api/jobs endpoint with a separate random secret.
CRON_SECRET=replace-with-another-random-secret
# SMTP is required only for sending approved drafts and reminder emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Seed a development/test DB only. Never use a shared or hardcoded password.
SEED_PASSWORD=
ALLOW_DEMO_SEED=false
